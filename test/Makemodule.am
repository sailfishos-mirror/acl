TEST_EXTENSIONS = .run

XFAIL_TESTS = \
	test/nfs/nfsacl.run \
	test/nfs/nfs-dir.run
TESTS = \
	test/cp.run \
	test/getfacl-lfs.run \
	test/getfacl-noacl.run \
	test/getfacl-recursive.run \
	test/malformed-restore.run \
	test/misc.run \
	test/setfacl-X.run \
	test/root/getfacl.run \
	test/root/permissions.run \
	test/root/restore.run \
	test/root/setfacl.run \
	$(XFAIL_TESTS)

if UNSAFE_RESTORE_WARNINGS
TESTS += \
	test/restore.run \
	test/sbits-restore.run \
	test/utf8-filenames.run
endif

EXTRA_DIST += \
	test/make-tree \
	test/malformed-restore-double-owner.acl \
	test/run \
	test/runwrapper \
	test/sort-getfacl-output \
	test/test.passwd \
	test/test.group \
	$(TESTS)

check_LTLIBRARIES = libtestlookup.la

libtestlookup_la_SOURCES = test/test_passwd.c test/test_group.c
libtestlookup_la_LDFLAGS = -rpath $(abs_builddir)

# Make sure translations don't break tests when matching output.
AM_TESTS_ENVIRONMENT = \
	export LC_MESSAGES=C; \
	export srcdir=$(srcdir); \
	PATH="$(abs_top_builddir):$$PATH";
RUN_LOG_COMPILER = $(srcdir)/test/runwrapper
